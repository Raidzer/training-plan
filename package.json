{
  "name": "training-plan",
  "version": "1.2.0-beta",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 3100",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "npm run test:coverage && node src/scripts/openCoverageReport.mjs",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "bot": "tsx src/bot/index.ts",
    "bot:tools": "tsx src/bot/tools/index.ts",
    "db:up": "docker compose up -d db",
    "db:wait": "node wait-for-db.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx src/scripts/seed.ts",
    "type-check": "tsc --noEmit",
    "dev:init": "node init.js && npm run db:up && npm run db:wait && npm run db:migrate && npm run seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.0.0",
    "antd": "^6.6.8",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "grammy": "^1.46.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-mailer": "npm:nodemailer@^10.2.1",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "drizzle-kit": {
      "@esbuild-kit/core-utils": {
        "esbuild": "0.25.12"
      }
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
